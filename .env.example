# Copy to `.env` (git-ignored) and fill in before a production build.

# Public ORIGIN of the site — scheme + domain only, no path, no trailing slash.
# Used for canonical URLs, Open Graph images (LinkedIn needs absolute URLs)
# and sitemap.xml. Examples: https://ona.design · https://<user>.github.io
SITE_URL=

# Sub-path the site is served from. "/" for Vercel or a custom domain.
# GitHub Pages project site: "/<repository-name>/".
BASE_PATH=/
