{
  "name": "ona-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Portfolio of Ona — UX/UI Designer & Creative Technologist. Art × Technology.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "images": "node scripts/optimize-images.ts",
    "og": "node scripts/generate-og.ts",
    "predev": "npm run images",
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "build": "npm run images && npm run typecheck && vite build && vite build --ssr src/entry-server.tsx --outDir dist/.ssr && node scripts/prerender.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/opentype.js": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "opentype.js": "^2.0.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  }
}
